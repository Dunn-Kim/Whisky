// Code signing for builds of this branch.
//
// A clone signs locally (ad hoc), so it builds and runs on any Mac without an
// Apple developer account. To sign with your own team instead, create
// Signing.local.xcconfig next to this file (git ignores it), for example:
//
//     DEVELOPMENT_TEAM = <your team ID>
//     CODE_SIGN_IDENTITY = Apple Development
//     ENABLE_HARDENED_RUNTIME = YES
//
// Team IDs, certificates and provisioning profiles stay out of the repository.

CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
// The hardened runtime's library validation refuses an ad hoc framework (Sparkle) in an
// ad hoc app: neither has a team ID. Only notarized builds need the hardened runtime.
ENABLE_HARDENED_RUNTIME = NO

#include? "Signing.local.xcconfig"
